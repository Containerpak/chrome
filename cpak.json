{
    "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v2.json",
    "name": "Google-Chrome",
    "description": "Google Chrome web browser.",
    "manifest_version": "2.0",
    "version": "151.0.7922.108-1",
    "image": "ghcr.io/containerpak/chrome-cpak:main",
    "binaries": [
        "/usr/bin/google-chrome"
    ],
    "desktop_entries": ["/usr/share/applications/google-chrome.desktop"],
    "dependencies": [],
    "addons": [],
    "idle_time": 0,
    "override": {
        "socketX11": true,
        "socketWayland": true,
        "socketPulseAudio": true,
        "socketSessionBus": true,
        "socketSystemBus": false,
        "socketSshAgent": false,
        "socketCups": true,
        "socketGpgAgent": false,
        "socketAtSpiBus": false,
        "socketBluetooth": true,
        "deviceDri": true,
        "deviceAll": false,
        "deviceShm": true,
        "deviceVideo": true,
        "notification": true,
        "openURI": true,
        "filesystem": [
            {"path": "home", "access": "read-write"}
        ],
        "env": [],
        "network": true,
        "process": false,
        "userNamespaces": true,
        "asRoot": false,
        "allowedHostCommands": []
    }
}
